# VCS
.git
.gitignore
.gitattributes

# IDE / OS junk
.idea
.vscode
.fleet
.DS_Store
Thumbs.db

# Local env (Coolify injects production env vars)
.env
.env.*
!.env.example

# PHP / Composer (rebuilt in vendor stage)
/vendor

# Node / Vite (rebuilt in assets stage)
/node_modules
/public/build
/public/hot

# Storage runtime artifacts (the Coolify volume mount provides these)
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*

# storage:link symlink — recreated at runtime by entrypoint
/public/storage

# Tests + dev tools
/tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# Local SQLite (we use MySQL in prod)
/database/database.sqlite

# Docker artifacts (we don't copy these into the image)
/Dockerfile
/.dockerignore
/docker-compose.yml

# Logs & misc
*.log
npm-debug.log*
yarn-error.log
.cache
